{
  "name": "beep-me",
  "version": "0.2.0",
  "private": true,
  "description": "Remote MCP server on Cloudflare Workers that lets Claude, Claude Code, and any AI agent message you by SMS, Telegram, email, Slack, Discord, or phone push.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cloudflare-workers",
    "notifications",
    "ai-agents",
    "claude",
    "claude-code",
    "telegram",
    "sms",
    "twilio",
    "telnyx",
    "push-notifications",
    "ntfy",
    "pushover",
    "webhooks"
  ],
  "homepage": "https://github.com/yannelli/beep-me#readme",
  "bugs": {
    "url": "https://github.com/yannelli/beep-me/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannelli/beep-me.git"
  },
  "license": "MIT",
  "author": {
    "name": "Ryan Yannelli",
    "url": "https://ryanyannelli.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc -b",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "check:docs": "node scripts/check-docs.mjs",
    "setup": "node scripts/cli/main.ts setup",
    "cli": "node scripts/cli/main.ts",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.19",
    "worker-mailer": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@cloudflare/vite-plugin": "^1.70.0",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  },
  "packageManager": "bun@1.4.4"
}
